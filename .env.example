# Environment variables for Vite (prefix with VITE_ to expose to the client)

# API base URL used by the frontend apiClient.
# In development, use a relative path so requests are routed through the
# Vite dev-server proxy (configured in vite.config.ts):
VITE_API_URL=/api/v1

# For production builds, point to the deployed backend:
# VITE_API_URL=https://api.example.com/api/v1

# The proxy target is derived automatically from VITE_API_URL when it is an
# absolute URL. If VITE_API_URL is a relative path, the proxy falls back to:
# VITE_PROXY_TARGET=http://localhost:3000
